# Copy to backend/.env for local development.
APP_NAME=NLCRA
ENVIRONMENT=development

# Optional shared access code. Empty = disabled.
APP_ACCESS_CODE=

# Liepin Agent API
LIEPIN_BASE_URL=https://open-agent.liepin.com
LIEPIN_TIMEOUT_SECONDS=30

# DeepSeek (server-side only; never expose to the browser)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Keep true for local demos without a token/key.
DEMO_MODE=true

# Comma-separated frontend origins for local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
