# Copy to .env before `docker compose up`.
# Never commit the real .env.

APP_NAME=NLCRA
ENVIRONMENT=production

# Optional shared access gate. Set a long random string for public deployments.
APP_ACCESS_CODE=

# Liepin Agent API (official REST endpoint)
LIEPIN_BASE_URL=https://open-agent.liepin.com
LIEPIN_TIMEOUT_SECONDS=30

# DeepSeek is configured once on the server; users never enter this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Keep true to let the UI work without a token/key.
DEMO_MODE=true

# Only needed for local Vite dev; production is same-origin through Caddy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
