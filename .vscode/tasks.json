{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "后端: 启动",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "前端: 启动",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/vite/bin/vite.js",
        "--host",
        "127.0.0.1",
        "--port",
        "5173"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "启动全部（前端 + 后端）",
      "dependsOn": [
        "后端: 启动",
        "前端: 启动"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
